# --- Secrets / env (never commit) ---
.env
*.env
!*.env.example
deploy/.env

# --- Node / Next.js ---
node_modules/
.next/
out/
dist/
build/
*.tsbuildinfo
.turbo/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# --- Data / runtime ---
*.sqlite
*.sqlite3
*.db
data/
pgdata/

# --- Offline basemap ---
# The PMTiles world archive (0.5–17 GB depending on max zoom) and the pmtiles CLI
# that builds it are DEPLOYMENT ARTEFACTS, not source. Build with
# `npm run map:tiles` in frontend/, then copy the archive to the target host.
# The glyphs and sprites under frontend/public/map/ ARE committed — they are small
# and the image must build without network.
deploy/tiles/

# The Photon address index (a few GB unpacked) and its jar. Provisioned by the
# geocoder container on first start, or dropped in by hand on an air-gapped host.
deploy/geocoder/

# --- OS / editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# --- e2e (Playwright, top-level e2e/) ---
# The suite runs against a REAL stack, so its outputs are per-run artefacts of
# one machine's environment — never source. `e2e/.env` is listed for the same
# reason `deploy/.env` is: the operator credentials the suite reads live in the
# environment and must never reach a commit.
e2e/node_modules/
e2e/test-results/
e2e/playwright-report/
e2e/blob-report/
e2e/.env
e2e/.env.*
!e2e/.env.example
