# Copy to e2e/.env (gitignored) or just export these — the suite reads the
# environment and nothing else. There is NO default password anywhere in this
# repo and there must never be one.
#
# Use an account that exists on the deployment you are pointing at. The suite is
# read-only, so a read-only operator role is enough; it never creates, edits or
# deletes anything.
E2E_EMAIL=operator@example.com
E2E_PASSWORD=
# Optional. Where the console is served — the GATEWAY, not the frontend
# container's :3000, which 404s every /api/v1 call.
E2E_BASE_URL=http://localhost
