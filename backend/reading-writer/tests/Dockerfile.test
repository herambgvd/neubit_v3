# The shipped reading-writer image plus a test runner. One networked build, then
# the suite runs offline. Local only — never pushed, never in the appliance.
#
# FROM the service image rather than a fresh python base, so the suite runs
# against the same sqlalchemy/pydantic the writer does, and so `/opt/reporting`
# (schema package AND its migrations) is present for the schema-completeness test.
ARG READING_WRITER_IMAGE=neubit-v3-reading-writer:latest
FROM ${READING_WRITER_IMAGE}

COPY requirements-test.txt /tmp/requirements-test.txt
RUN pip install --no-cache-dir --disable-pip-version-check -r /tmp/requirements-test.txt
