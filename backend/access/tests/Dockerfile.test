# The shipped access image plus a test runner. One networked build, then the suite
# runs offline. Local only — never pushed, never in the appliance.
ARG ACCESS_IMAGE=neubit-v3-access:latest
FROM ${ACCESS_IMAGE}

COPY requirements-test.txt /tmp/requirements-test.txt
RUN pip install --no-cache-dir --disable-pip-version-check -r /tmp/requirements-test.txt
