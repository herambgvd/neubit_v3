# The test image: core's shipped image plus a test runner, and nothing else.
#
# Test deps are installed at build time so the suite itself can run with
# --network none: one networked build, cached until requirements-test.txt changes,
# then offline runs forever.
#
# FROM the core image rather than repeating its dependency list, so the suite runs
# against the same fastapi/sqlalchemy/pyjwt the service does.
#
# Local to a developer's machine: never pushed, not part of the appliance payload,
# and deliberately not a stage of backend/core/Dockerfile.
ARG CORE_IMAGE=neubit-v3-core:latest
FROM ${CORE_IMAGE}

COPY requirements-test.txt /tmp/requirements-test.txt
RUN pip install --no-cache-dir --disable-pip-version-check -r /tmp/requirements-test.txt
