# ─────────────────────────────────────────────────────────────────────────────
# Neubit v3 — deployment environment TEMPLATE.
#
#     cp .env.example .env      then edit every `change-me` and the tenant map.
#
# WHY THIS FILE EXISTS. `deploy/.env` is gitignored, correctly — it holds
# secrets. But it had no example counterpart, so nothing about it travelled with
# the repo, and the settings that are NOT secrets travelled with it into the
# void. VE_READINGS_TENANT_MAP is the one that bites: unset, the reading-writer
# resolves the gateway's tenant key to a stable SYNTHETIC uuid, writes every
# reading under it, and the UI — which queries by the real tenant — shows an
# empty building. Nothing errors. The only signal is a metric
# (`reading_writer_unmapped_tenant_keys`) that nobody is watching.
#
# So: every variable a deployment must set lives here, with the failure it
# causes when it is wrong. Keep this file in step when you add one — an
# undocumented variable is a variable that will be missing on the next machine.
# ─────────────────────────────────────────────────────────────────────────────

POSTGRES_USER=neubit
POSTGRES_PASSWORD=change-me
POSTGRES_DB=neubit_control

VE_ENV=dev
VE_DATABASE_URL=postgresql+asyncpg://neubit:change-me@postgres:5432/neubit_control
VE_REDIS_URL=redis://redis:6379/0
VE_NATS_URL=nats://nats:4222
VE_JWT_SECRET=change-me-to-a-long-random-string-at-least-32-bytes
VE_SECRETS_KEY=change-me-to-another-long-random-string
VE_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
VE_BOOTSTRAP_ADMIN_PASSWORD=change-me-before-first-boot
VE_CORS_ORIGINS=["http://localhost:3000","http://localhost"]
VE_STORAGE_BACKEND=local
VE_STORAGE_LOCAL_DIR=/app/data/storage

# ── Satellite services (ingest / workflow) ─────────────────────────
# Each owns its OWN database on the shared postgres. The actual VE_DATABASE_URL
# for these services is set PER-SERVICE in docker-compose.yml (so it overrides the
# core's control-DB url from this shared env_file). Listed here for reference:
#   ingest    → postgresql+asyncpg://neubit:neubit@postgres:5432/neubit_ingest
#   workflow  → postgresql+asyncpg://neubit:neubit@postgres:5432/neubit_workflow
# They reuse VE_JWT_SECRET (verify core tokens), VE_NATS_URL (event spine), and
# VE_REDIS_URL (workflow Celery broker) from this file — no new vars required.

# Frontend → core API base (browser hits core directly for the first bring-up).
NEXT_PUBLIC_API_URL=http://localhost

# ── Infra-control sidecar (ops-agent) ──────────────────────────────
# Shared secret between core and the privileged ops-agent. Core sends it as the
# X-Ops-Token header on every /admin/infra proxy call. Rotate for production.
OPS_AGENT_TOKEN=generate-with-openssl-rand-base64-48
# Where core reaches the ops-agent (internal docker network; no host port).
OPS_AGENT_URL=http://ops-agent:9000

# ── Reporting store (IoT readings pipeline) ────────────────────────
# neubit_reporting on the shared postgres (TimescaleDB). Its VE_DATABASE_URL is
# set per-service in docker-compose.yml, like ingest/workflow:
#   reporting  → postgresql+asyncpg://neubit:neubit@postgres:5432/neubit_reporting
#
# Retention / compression are DEPLOYMENT settings, not schema constants —
# different deployments have different compliance rules. Uncomment and edit, then
# `docker compose up -d reporting-migrate` to reconcile the live policies.
# `off` disables a retention policy entirely. Docs: backend/reporting/reporting/policies.py
#VE_READINGS_CHUNK_INTERVAL=1 day
#VE_READINGS_COMPRESS_AFTER=7 days          # compress raw chunks older than
#VE_READINGS_1M_COMPRESS_AFTER=30 days
#VE_READINGS_1H_COMPRESS_AFTER=365 days
#VE_READINGS_RETENTION=90 days              # raw: short
#VE_READINGS_1M_RETENTION=400 days          # rollups: long
#VE_READINGS_1H_RETENTION=1825 days
#VE_READINGS_1M_REFRESH_START=2 hours
#VE_READINGS_1M_REFRESH_END=1 minute
#VE_READINGS_1M_REFRESH_EVERY=1 minute
#VE_READINGS_1H_REFRESH_START=1 day
#VE_READINGS_1H_REFRESH_END=1 hour
#VE_READINGS_1H_REFRESH_EVERY=5 minutes

# ── IoT reading-writer (Phase B) ───────────────────────────────────
# Defaults live in docker-compose.yml; override here per deployment.
#
# TENANT MAPPING — read this before wondering where your readings went.
# The gateway publishes ITS OWN tenant key on the wire. The live aeon connection
# has no tenant configured on the conflux side, so it publishes the literal
# string `default` (subject `tenant.default.iot.reading....`). `readings.tenant_id`
# is a `uuid NOT NULL`, so a non-UUID key is resolved: mapped here if listed,
# otherwise a stable synthetic UUIDv5 of the key plus a WARNING in the writer log
# and a non-zero `reading_writer_unmapped_tenant_keys` metric.
#
# Deliberately left UNSET: which platform tenant owns a gateway's feed is a
# deployment decision, not something the writer should guess. Point it at the real
# tenant and restart the writer, e.g.:
#   # ⚠ REQUIRED on any deployment with a gateway feed. Leaving it unset does not
# fail — it silently files every reading under a synthetic tenant the UI cannot
# see. Find the real tenant id with:
#   docker compose exec postgres psql -U "$POSTGRES_USER" -d neubit_control \
#     -c "select id, slug from tenants;"
VE_READINGS_TENANT_MAP=default=00000000-0000-0000-0000-000000000000
# Comma-separate several: `default=<uuid>,plantB=<uuid>`.
# ⚠ REQUIRED on any deployment with a gateway feed. Leaving it unset does not
# fail — it silently files every reading under a synthetic tenant the UI cannot
# see. Find the real tenant id with:
#   docker compose exec postgres psql -U "$POSTGRES_USER" -d neubit_control \
#     -c "select id, slug from tenants;"
VE_READINGS_TENANT_MAP=default=00000000-0000-0000-0000-000000000000
# Fallback for ANY unmapped non-UUID key (takes precedence over the synthetic id):
# VE_READINGS_DEFAULT_TENANT_ID=

# ── DashForge embed integration ────────────────────────────────────
# DashForge is the single dashboarding surface; NeuBit registers which of its
# dashboards it shows and embeds them. Leave BASE_URL / EMAIL / PASSWORD unset
# and the integration is simply OFF: registrations still list and manage, and
# asking for an embed session answers 503 naming the missing configuration.
# Nothing fails to boot.
#
# BASE_URL is how the `dashforge` SERVICE reaches DashForge (compose network).
# PUBLIC_URL is how a BROWSER reaches it — the iframe src is resolved by the
# operator's machine, which is not on that network, so these are different
# values and an internal service name in PUBLIC_URL produces an iframe that
# silently never loads.
VE_DASHFORGE_BASE_URL=http://dashforge-backend:8080
VE_DASHFORGE_PUBLIC_URL=http://localhost:3100
# The DashForge SERVICE ACCOUNT. This account is the ceiling on what any NeuBit
# viewer can ever be shown, so give it the lowest role that can mint an embed
# token (editor) in the ONE workspace whose dashboards this platform embeds —
# never a DashForge super-admin.
VE_DASHFORGE_EMAIL=
VE_DASHFORGE_PASSWORD=
# Embed-token lifetime in MINUTES. The reasoning for 15 is in
# backend/dashforge/app/embeds/client.py, next to the mint call: the token is a
# bearer credential that travels in a URL, so this is the window in which a
# copied URL keeps working. Raising it into hours re-creates the leak the
# per-session mint exists to close.
VE_DASHFORGE_TOKEN_TTL_MINUTES=15
#
# ── the DashForge PEER itself (docker-compose.dashforge.yml, opt-in) ──
# Only read when that file is named on the compose command line. See its header.
# DASHFORGE_REPO=/path/to/dashforge/project
# Distinct secrets, not one. EMBED_SECRET signs tokens that are handed to
# browsers by design; DashForge falls back to JWT_SECRET when it is unset, and
# then a leaked embed secret is a session-forging key.
# DASHFORGE_JWT_SECRET=
# DASHFORGE_JWT_REFRESH_SECRET=
# DASHFORGE_ENCRYPTION_KEY=
# DASHFORGE_EMBED_SECRET=
# Which origins may iframe an embed page. NOT "*": that is what stops a leaked
# token from being framed into somebody else's page.
# DASHFORGE_FRAME_ANCESTORS=http://localhost http://localhost:80
# DASHFORGE_SUPERADMIN_EMAILS=
