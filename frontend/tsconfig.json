{
  "compilerOptions": {
    // The console is fully TypeScript: allowJs is off, so a stray .js file is a
    // build error rather than a silently untyped island.
    "allowJs": false,
    // Fully strict. Turned on a flag at a time — strictNullChecks first (it is
    // what catches real null bugs, and without it TypeScript will not even
    // narrow a discriminated union on a boolean), then noImplicitAny once every
    // feature area had real types rather than inferred `any`.
    "strict": true,
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.js",
    "**/*.jsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
