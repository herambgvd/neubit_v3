{
  "compilerOptions": {
    // The console is fully TypeScript: allowJs is off, so a stray .js file is a
    // build error rather than a silently untyped island.
    "allowJs": false,
    // `strict` is being turned on a flag at a time. noImplicitAny is the one
    // still outstanding (~2.5k call sites, tracked in the README).
    "strict": true,
    // Enabled ahead of full `strict`: this is the flag that catches real null and
    // undefined bugs, and without it TypeScript will not even narrow a
    // discriminated union on a boolean, which silently weakens every guard.
    "strictNullChecks": true,
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.js",
    "**/*.jsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
